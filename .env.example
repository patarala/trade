APP_HOST=localhost
APP_PORT=8000

POSTGRES_DB=exchange_simulator
POSTGRES_USER=exchange_user
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://exchange_user:change_me@localhost:5433/exchange_simulator

JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
PASSWORD_PEPPER=change_me

# Optional Regimex connection. Keep the service credential on the backend.
# REGIMEX_URL=https://regimex.example.com
# REGIMEX_TOKEN=replace_with_a_connection_key
# REGIMEX_SOURCE_ID=trade
# Per API process; excess analysis requests return 503 with Retry-After.
# REGIMEX_MAX_CONCURRENT_REQUESTS=4
# For a local Regimex service only:
# REGIMEX_URL=http://127.0.0.1:8000
# REGIMEX_ALLOW_LOOPBACK_HTTP=true
